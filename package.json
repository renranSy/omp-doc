{
  "name": "omp-docs-zh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vitepress dev content",
    "preview": "vitepress preview content",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:content": "node scripts/check-content.mjs",
    "check:render": "node scripts/check-rendered-pages.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "build": "vitepress build content && node scripts/generate-robots.mjs && node scripts/generate-clean-url-folders.mjs"
  },
  "dependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.2",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vue-tsc": "^3.1.1"
  }
}
